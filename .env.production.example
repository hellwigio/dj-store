# Copy to .env.production; never commit the populated file.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# Use URL-encoded credentials. For external DBs use TLS (e.g. ?sslmode=verify-full).
DATABASE_URL=postgresql://app:REPLACE_ME@db:5432/app
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_ME
DJANGO_TRUST_PROXY=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
